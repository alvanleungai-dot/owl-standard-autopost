# Owl Standard — required configuration.
# Copy to secrets/owl-standard/.env (gitignored). Never commit real values.
#
# getEnv() reads, in order — first hit wins:
#   1. process.env                  (Render sets everything here)
#   2. secrets/owl-standard/.env    (this file's destination)
#   3. .env                         (repo root, local convenience)
#
# Verify with:   node scripts/owl-standard/doctor.mjs     (free, no API call — also catches wrong switch values)
#                node scripts/check-keys.mjs              (live connection test)

# ── 1. AI providers ────────────────────────────────────────────────────────────
# Writing/planning (Claude Haiku 4.5) — console.anthropic.com
ANTHROPIC_API_KEY=
# ── Image provider ────────────────────────────────────────────────────────────
# "higgsfield" (default) uses your existing Higgsfield account. "openai" uses gpt-image-2.
# Both render the Traditional Chinese text INSIDE the poster, which is the deciding factor —
# see scripts/lib/image-backend.mjs.
IMAGE_BACKEND=higgsfield
# Higgsfield API credentials — cloud.higgsfield.ai -> API. BOTH are required.
# NOTE: a web-app subscription alone does not necessarily include API access; check your account.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# ⚠️ SET THIS — the default is NOT the model you want.
# The poster renders Traditional Chinese inside the image, so the model must be good at text. The API
# model path is account-dependent: run `node scripts/owl-standard/verify-higgsfield.mjs` to probe it,
# or read it off console.higgsfield.ai/explore. Leaving this blank falls back to a Flux Pro path whose
# availability and Chinese glyph accuracy are both unverified.
HIGGSFIELD_ENDPOINT=
# Optional model id, if the endpoint takes one. Leave blank for that endpoint's default.
HIGGSFIELD_MODEL=
# Optional JSON object merged into the request body, for model-specific fields without a code change.
# e.g. {"seed":42,"safety_tolerance":3}
HIGGSFIELD_PARAMS=

# Only needed when IMAGE_BACKEND=openai — platform.openai.com
OPENAI_API_KEY=

# ── 2. Telegram — TWO SEPARATE BOTS ────────────────────────────────────────────
# Both come from @BotFather. They must be DIFFERENT bots: alert.mjs deliberately refuses to send ops
# alarms through the review bot, and the worker REFUSES TO BOOT if the ops channel is unset.
# Press START on BOTH bots from your own Telegram account first — a bot cannot message you until you do.
# (a) the review bot — sends posters for your ✅/❌/🔁 decision
TELEGRAM_BOT_TOKEN_OWLSTANDARD=
# (b) the ops/alarm bot — failure alerts only
TELEGRAM_BOT_TOKEN__OPS=
# Your numeric chat id (message either bot, then run: node scripts/get-chat-id.mjs).
# Only this chat can approve posts; buttons pressed anywhere else are ignored.
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=

# ── 3. Meta (Facebook + Instagram) ─────────────────────────────────────────────
# Page access token. Recommended: a System User token from Meta Business Settings (it does not expire).
# Permissions: pages_manage_posts, pages_read_engagement, pages_show_list,
#              instagram_basic, instagram_content_publish. Requires Editor/Admin on the Owl Standard Page.
FB_PAGE_TOKEN_OWLSTANDARD=
# The Owl Standard Facebook Page ID. api-schedule.mjs FAILS CLOSED without it rather than guessing.
FB_PAGE_ID_OWLSTANDARD=
# The Instagram BUSINESS account id, linked to that Page. api-ig-daily.mjs fails closed without it.
IG_USER_ID_OWLSTANDARD=

# ── 4. Cloudinary — REQUIRED FOR INSTAGRAM ONLY ────────────────────────────────
# Meta's IG publishing API takes a public image URL, not an upload, so each poster is pushed to
# Cloudinary, published, then deleted. Free tier is ample. Facebook-only posting does not need this.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── 5. Runtime switches ────────────────────────────────────────────────────────
# ⚠️ EXACT VALUES. A wrong value does not error — it silently leaves the thing OFF.
#   PUBLISHING_ENABLED must be exactly 1        (not "true")
#   every JOB_*_ENABLED must be exactly true   (not "1")
#
# Master publish switch (cloud only). Leave unset until you have watched a full generate→approve cycle.
# NOTE: on your own PC this switch does NOT block publishing — run publishers with --dry when testing.
PUBLISHING_ENABLED=
# Every job defaults OFF. Turn on one at a time.
JOB_OWL_STANDARD_WEEKLY_AUTOPILOT_ENABLED=
JOB_OWL_STANDARD_REVIEW_BOT_ENABLED=
JOB_SCE_FB_TOPUP_ENABLED=
JOB_OWL_STANDARD_IG_DAILY_ENABLED=
JOB_SCE_PREFLIGHT_ENABLED=
JOB_SCE_CATCHUP_ENABLED=
# Re-generates posts whose generation failed, and unblocks stuck publish records. Only spends money
# when a post actually failed.
JOB_SCE_REPAIR_ENABLED=
# OPTIONAL — recommended OFF. Inspects every poster with a paid vision model and re-draws (paid) the
# ones it dislikes. Every post is already approved by a person, so this mostly adds cost.
JOB_SCE_POSTER_QA_ENABLED=

# ── 6. Review behaviour ────────────────────────────────────────────────────────
# Leave unset: NOTHING publishes until you approve it in Telegram. "true" re-enables the old
# 48-hour auto-approval (not recommended).
REVIEW_AUTO_APPROVE_ENABLED=
# "monthly" (default): one batch of posters on the 1st of each month, plus anything publishing within
# 7 days that you have not seen. "weekly": posters arrive right after each Thursday generation.
REVIEW_DELIVERY_MODE=monthly
# How many weeks ahead to keep generated (default 5, so the whole next month exists on the 1st).
CATCHUP_QUEUE_WEEKS=5
